{
	"name": "sure",
	"version": "1.0.0",
	"private": true,
	"description": "The personal finance app for everyone",
	"license": "ISC",
	"author": "",
	"scripts": {
		"style:check": "biome check",
		"style:fix": "biome check --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"lint:rails": "biome lint",
		"lint:web": "oxlint --ignore-pattern '**/__fixtures__/**' apps",
		"lint:web:fix": "oxlint --fix --ignore-pattern '**/__fixtures__/**' apps",
		"format:check": "biome format",
		"format": "biome format --write",
		"format:rails": "biome format",
		"format:check:web": "oxfmt --check apps package.json pnpm-workspace.yaml",
		"format:web": "oxfmt --write apps package.json pnpm-workspace.yaml",
		"typecheck": "pnpm -r --if-present run typecheck",
		"test": "pnpm -r --if-present run test",
		"checks:web": "pnpm typecheck && pnpm lint:web && pnpm format:check:web && pnpm test",
		"tokens:build": "node bin/tokens.mjs",
		"tokens:check": "node bin/tokens.mjs && git diff --quiet -- app/assets/tailwind/sure-design-system/_generated.css apps/web/src/styles/sure-tokens.stylex.ts apps/web/src/styles/sure-token-values.ts apps/web/src/styles/sure-theme.css",
		"web:dev": "pnpm --filter @sure/web dev",
		"web:build": "pnpm --filter @sure/web build",
		"web:preview": "pnpm --filter @sure/web preview",
		"web:typecheck": "pnpm --filter @sure/web typecheck",
		"web:test": "pnpm --filter @sure/web test",
		"web:api:generate": "pnpm --filter @sure/web api:generate",
		"web:api:check": "pnpm --filter @sure/web api:check",
		"web:contracts:generate": "pnpm --filter @sure/web contracts:generate",
		"web:contracts:check": "pnpm --filter @sure/web contracts:check",
		"web:install:clean": "pnpm install --frozen-lockfile",
		"install:clean": "pnpm install --frozen-lockfile"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.3",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.15.0"
}
