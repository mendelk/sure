<% content_for :page_title, t("web_notifications.preferences.title") %>
<% content_for :page_actions do %>
  <%= render DS::Link.new(text: t("web_notifications.inbox.title"), href: web_notifications_path, variant: :outline, icon: "bell") %>
<% end %>

<%= render DS::Pill.new(label: t("shared.preview")) %>
<% if params[:updated] == "1" %>
  <%= render DS::Alert.new(message: t("web_notifications.preferences.saved"), variant: :success) %>
<% elsif params[:revoked] == "1" %>
  <%= render DS::Alert.new(message: t("web_notifications.browser.revoked"), variant: :success) %>
<% end %>
<% if @preferences.errors.any? %>
  <%= render DS::Alert.new(title: t("web_notifications.preferences.invalid"), message: @preferences.errors.full_messages.to_sentence, variant: :error) %>
<% end %>

<%= styled_form_with scope: :web_notifications, url: settings_web_notifications_path, method: :patch, class: "space-y-4" do |form| %>
  <%= settings_section title: t("web_notifications.preferences.opt_in"), subtitle: t("web_notifications.preferences.baseline") do %>
    <%= render "toggle", name: "enabled", checked: @preferences.enabled? %>
  <% end %>

  <%= settings_section title: t("web_notifications.preferences.events") do %>
    <fieldset class="space-y-3">
      <legend class="sr-only"><%= t("web_notifications.preferences.events") %></legend>
      <%= hidden_field_tag "web_notifications[event_types][]", "", id: nil %>
      <% web_notification_event_types.each do |event_type| %>
        <label class="flex items-center gap-3 text-sm text-primary">
          <%= check_box_tag "web_notifications[event_types][]", event_type, @preferences.event_types.include?(event_type), id: "web_notification_event_#{event_type}", class: "checkbox checkbox--light" %>
          <%= t("web_notifications.events.#{event_type}.label") %>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <%= settings_section title: t("web_notifications.preferences.accounts"), subtitle: t("web_notifications.preferences.accounts_hint") do %>
    <fieldset class="grid gap-3 sm:grid-cols-2">
      <legend class="sr-only"><%= t("web_notifications.preferences.accounts") %></legend>
      <%= hidden_field_tag "web_notifications[account_ids][]", "", id: nil %>
      <% @accounts.each do |account| %>
        <label class="flex items-center gap-3 text-sm text-primary min-w-0">
          <%= check_box_tag "web_notifications[account_ids][]", account.id, @preferences.account_ids.include?(account.id), id: "web_notification_account_#{account.id}", class: "checkbox checkbox--light" %>
          <span class="break-words privacy-sensitive"><%= account.name %> (<%= account.currency %>)</span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <%= settings_section title: t("web_notifications.preferences.transactions") do %>
    <div class="space-y-4">
      <%= render "toggle", name: "include_pending", checked: @preferences.include_pending? %>
      <p class="text-sm text-secondary"><%= t("web_notifications.preferences.minimum_amounts_hint") %></p>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @currencies.each do |currency| %>
          <%= form.fields_for :minimum_amounts do |amounts| %>
            <%= amounts.number_field currency, label: t("web_notifications.preferences.minimum_amount", currency: currency), value: @preferences.minimum_amounts.fetch(currency, "0"), min: 0, step: "any", inputmode: "decimal" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= settings_section title: t("web_notifications.preferences.delivery") do %>
    <div class="space-y-4">
      <p class="text-sm text-secondary"><%= t("web_notifications.preferences.timezone", timezone: @preferences.timezone) %></p>
      <%= form.select :frequency, [[t("web_notifications.preferences.immediate"), "immediate"], [t("web_notifications.preferences.daily_digest"), "daily_digest"]], { label: t("web_notifications.preferences.frequency"), selected: @preferences.frequency } %>
      <div class="grid gap-3 sm:grid-cols-2">
        <%= form.time_field :digest_at, label: t("web_notifications.preferences.digest_at"), value: @preferences.digest_at, required: true %>
        <%= form.time_field :quiet_start, label: t("web_notifications.preferences.quiet_start"), value: @preferences.quiet_start %>
        <%= form.time_field :quiet_end, label: t("web_notifications.preferences.quiet_end"), value: @preferences.quiet_end %>
      </div>
      <p class="text-xs text-secondary"><%= t("web_notifications.preferences.quiet_hint") %></p>
      <%= render "toggle", name: "show_details", checked: @preferences.show_details? %>
    </div>
  <% end %>

  <%= settings_section title: t("web_notifications.preferences.reminders") do %>
    <div class="grid gap-3 sm:grid-cols-2">
      <%= form.number_field :bill_days_before, label: t("web_notifications.preferences.bill_days_before"), value: @preferences.bill_days_before, min: 0, max: 30, step: 1, required: true %>
      <%= form.number_field :budget_threshold_pct, label: t("web_notifications.preferences.budget_threshold_pct"), value: @preferences.budget_threshold_pct, min: 1, max: 1000, step: 1, required: true %>
    </div>
  <% end %>
  <%= render DS::Button.new(text: t("web_notifications.preferences.save"), type: "submit", full_width: true) %>
<% end %>

<%= render "browser", preferences: @browser_preferences, subscriptions: @subscriptions %>
