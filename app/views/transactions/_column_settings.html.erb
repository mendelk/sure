<%# locals: (prefix: "global") %>
<%# Column visibility settings for transaction tables (desktop). %>
<%# Must render inside a `transaction-columns` controller scope. Persists to localStorage. %>
<%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
  <% popover.with_button(
    id: "transaction-columns-button",
    type: "button",
    text: t("transactions.column_settings.columns"),
    variant: "outline",
    icon: "sliders-horizontal"
  ) %>

  <% popover.with_custom_content do %>
    <div class="p-3 space-y-3 min-w-[180px]">
      <p class="text-xs font-medium text-secondary uppercase"><%= t("transactions.column_settings.title") %></p>
      <% %w[tags merchant notes].each do |column| %>
        <div class="flex items-center gap-3">
          <%# `form:` points at a non-existent form so these toggles never %>
          <%# submit with an ancestor search form; they only drive localStorage. %>
          <%= check_box_tag "columns[#{column}]",
                            "1",
                            true,
                            id: "columns_#{column}_#{prefix}",
                            form: "transaction-columns-detached",
                            class: "checkbox checkbox--light",
                            data: {
                              transaction_columns_target: "toggle",
                              key: column,
                              action: "change->transaction-columns#toggle"
                            } %>
          <%= label_tag "columns_#{column}_#{prefix}", t("transactions.column_settings.#{column}"), class: "text-sm text-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
