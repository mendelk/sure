<%# locals: (entry:, transaction:, in_split_group: false) %>
<%# Notes display + quick edit for the transaction attributes column (desktop). %>
<%# The popover form PATCHes the existing transaction update endpoint %>
<%# (turbo_stream re-renders the row on save). %>
<%= render DS::Popover.new(variant: "button", placement: "bottom-start", max_width: "320px") do |popover| %>
  <% popover.with_button(class: "block min-w-0 max-w-full rounded-md focus-ring") do %>
    <span class="flex min-w-0 items-center gap-1 group/notes">
      <% if entry.notes.present? %>
        <span class="truncate text-sm text-secondary" title="<%= entry.notes %>"><%= truncate(entry.notes, length: 80) %></span>
      <% else %>
        <span class="text-xs text-secondary hover:text-primary transition-colors inline-flex items-center gap-1">
          <%= icon "plus", size: "xs", color: "current" %>
          <%= t("transactions.inline_notes.add_note") %>
        </span>
      <% end %>
      <span class="shrink-0 text-secondary opacity-60 group-hover/notes:opacity-100 transition-opacity" title="<%= t("transactions.inline_notes.edit_note") %>">
        <%= icon "file-text", size: "xs", color: "current" %>
      </span>
    </span>
  <% end %>

  <% popover.with_custom_content do %>
    <div class="p-3 w-72">
      <%= form_with model: entry,
            url: transaction_path(entry),
            method: :patch,
            class: "space-y-2" do |f| %>
        <%= hidden_field_tag :grouped, "true" if in_split_group %>
        <%= f.text_area :notes,
              rows: 3,
              placeholder: t("transactions.inline_notes.placeholder"),
              class: "form-field__input w-full text-sm",
              aria: { label: t("transactions.inline_notes.edit_note") } %>
        <div class="flex justify-end">
          <%= render DS::Button.new(
            type: "submit",
            text: t("transactions.inline_notes.save"),
            variant: "primary",
            size: :sm
          ) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
