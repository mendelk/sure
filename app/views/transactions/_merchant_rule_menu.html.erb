<%# locals: (transaction:, mobile:) %>

<% merchant = transaction.merchant %>
<% category = transaction.category %>

<div class="<%= mobile ? "flex items-center min-w-0 lg:hidden" : "hidden lg:inline-flex items-center min-w-0" %>">
  <% if mobile %>
    <span aria-hidden="true" class="mr-1 flex-shrink-0">•</span>
  <% end %>
  <%= render DS::Menu.new(
    variant: "button",
    placement: "bottom-start",
    offset: 4,
    mobile_fullwidth: false,
    max_width: "18rem",
    testid: "merchant-rule-menu-#{transaction.id}-#{mobile ? "mobile" : "desktop"}"
  ) do |menu| %>
    <% menu.with_button(
      type: "button",
      class: "flex max-w-full min-w-0 cursor-pointer rounded-sm text-secondary hover:underline focus-ring",
      aria: { label: t("transactions.merchant_rule_menu.merchant_button_label", merchant: merchant.name) }
    ) do %>
      <span class="truncate"><%= merchant.name %></span>
    <% end %>
    <% menu.with_item(
      variant: :link,
      text: t("transactions.merchant_rule_menu.view_transactions"),
      icon: "receipt-text",
      href: transactions_path(q: { merchants: [ merchant.name ] }),
      data: { turbo_frame: :_top }
    ) %>
    <% menu.with_item(
      variant: :link,
      text: t("transactions.merchant_rule_menu.edit_merchant"),
      icon: "pencil",
      href: edit_family_merchant_path(merchant),
      data: { turbo_frame: :modal }
    ) %>
    <% if category.present? %>
      <% menu.with_item(
        variant: :link,
        text: t("transactions.merchant_rule_menu.create_rule", category: category.name),
        icon: "plus",
        href: new_rule_path(
          resource_type: "transaction",
          merchant_id: merchant.id,
          action_type: "set_transaction_category",
          action_value: category.id
        ),
        frame: :modal
      ) %>
    <% end %>
  <% end %>
  <% unless mobile %>
    <span aria-hidden="true" class="ml-1 flex-shrink-0">•</span>
  <% end %>
</div>
