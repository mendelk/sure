<%# locals: (name:, accounts:, selected_id: nil) %>
<div class="min-w-36 max-w-56 flex-1 basis-48">
  <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1"><%= t("splits.new.transfer_label") %></label>
  <select name="<%= name %>"
          class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container">
    <option value=""><%= t("splits.new.transfer_prompt") %></option>
    <% accounts.each do |account| %>
      <option value="<%= account.id %>" <%= "selected" if account.id.to_s == selected_id.to_s %>><%= account.name %></option>
    <% end %>
  </select>
</div>
