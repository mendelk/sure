<% content_for :title, "React route · #{product_name}" %>
<% bootstrap = {
  currentUser: {
    id: Current.user.id,
    name: Current.user.display_name
  },
  railsPaths: {
    home: root_path
  }
} %>

<div id="spa-root"></div>
<script id="spa-bootstrap" type="application/json"><%= raw json_escape(bootstrap.to_json) %></script>
