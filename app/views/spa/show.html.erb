<% content_for :title, "Transactions · #{product_name}" %>
<% bootstrap = {
  currentUser: {
    id: Current.user.id,
    name: Current.user.display_name,
    initials: Current.user.initials,
    email: Current.user.email
  },
  apiPaths: {
    transactions: api_v1_transactions_path,
    summary: api_v1_balance_sheet_path,
    accounts: api_v1_accounts_path,
    categories: api_v1_categories_path,
    merchants: api_v1_merchants_path,
    tags: api_v1_tags_path,
    transfers: api_v1_transfers_path
  },
  railsPaths: {
    home: root_path,
    logo: image_path("logomark-color.svg"),
    accounts: accounts_path,
    budgets: budgets_path,
    imports: imports_path,
    newImport: new_import_path,
    newTransaction: new_transaction_path,
    reports: reports_path,
    settings: settings_profile_path,
    changelog: changelog_path,
    signOut: session_path(Current.session),
    transactions: transactions_path,
    familyMerchants: family_merchants_path,
    newRule: new_rule_path
  }
