<% page_title = if request.path == "/plan/projection"
  "Lifetime projection"
elsif request.path.start_with?("/dashboards")
  "Dashboards"
else
  "Transactions"
end %>
<% content_for :title, "#{page_title} · #{product_name}" %>
<% bootstrap = {
  currentUser: {
    id: Current.user.id,
    name: Current.user.display_name,
    initials: Current.user.initials,
    email: Current.user.email
  },
  apiPaths: {
    transactions: api_v1_transactions_path,
    recurringTransactions: api_v1_recurring_transactions_path,
    summary: api_v1_balance_sheet_path,
    accounts: api_v1_accounts_path,
    categories: api_v1_categories_path,
    merchants: api_v1_merchants_path,
    tags: api_v1_tags_path,
    transfers: api_v1_transfers_path,
    sureqlRun: dashboard_monarch_run_path
  },
  recurringTransactionsDisabled: Current.family.recurring_transactions_disabled?,
  uncategorizedCount: @uncategorized_count,
  railsPaths: {
    home: root_path,
    logo: image_path("logomark-color.svg"),
    accounts: accounts_path,
    budgets: budgets_path,
    dashboards: dashboards_path,
    imports: imports_path,
    newImport: new_import_path,
    newTransaction: new_transaction_path,
    reports: reports_path,
    lifetimeProjection: lifetime_projection_path,
    settings: settings_profile_path,
    changelog: changelog_path,
    signOut: session_path(Current.session),
    transactions: transactions_path,
    familyMerchants: family_merchants_path,
    newRule: new_rule_path,
    recurringTransactions: recurring_transactions_path,
    rules: rules_path,
    categories: categories_path,
    tags: tags_path,
    transactionsCategorize: transactions_categorize_path
  }
} %>

<div id="spa-root"></div>
<script id="spa-bootstrap" type="application/json"><%= raw json_escape(bootstrap.to_json) %></script>
