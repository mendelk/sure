<% page_title = if request.path == "/"
     t("pages.dashboard.new", default: "Home")
   elsif request.path == "/plan/projection"
     "Lifetime projection"
   elsif request.path.start_with?("/sources")
     "Sources"
   elsif request.path.start_with?("/account_statements") || request.path.start_with?("/statements")
     t("account_statements.index.title")
   elsif request.path == "/accounts" || request.path == "/accounts/"
     t("accounts.index.accounts")
   elsif request.path == "/accounts/new" || request.path.start_with?("/accounts/new/")
     t("accounts.show.spa.accountable_title_new")
   elsif request.path.start_with?("/valuations")
     t(request.path == "/valuations/new" ? "valuations.new.title" : "valuations.header.balance")
   elsif request.path.start_with?("/tags")
     t("tags.index.tags")
   elsif request.path.start_with?("/categories")
     t("categories.index.categories")
   elsif request.path.start_with?("/family_merchants")
     t("merchants.index.title")
   elsif request.path.start_with?("/rules")
     t("rules.index.page_title")
   elsif request.path.start_with?("/chats")
     t("chats.index.chats")
   elsif request.path.end_with?("/edit")
     t("accounts.show.spa.accountable_title_edit")
   elsif request.path.start_with?("/accounts")
     @account.name
   else
     "Transactions"
   end %>
<% content_for :title, "#{page_title} · #{product_name}" %>
<% account_currencies = Current.user.accessible_accounts.pluck(:id, :currency).to_h %>
<% default_account = Current.user.default_account_for_transactions %>
<%# Mirrors the desktop nav composition in layouts/application.html.erb
    (bills_nav_item / plan_nav_item preview gating included) so the SPA rail
    stays in lockstep with the Rails sidebar. Active state is computed
    client-side from the rendered path. %>
<% nav_items = [
  { name: t("layouts.application.nav.home"), path: root_path, icon: "pie-chart" },
  { name: t("layouts.application.nav.dashboards"), path: dashboards_path, icon: "layout-dashboard" },
  { name: t("layouts.application.nav.transactions"), path: transactions_path, icon: "credit-card" },
  { name: "Projection", path: lifetime_projection_path, icon: "chart-bar" },
  bills_nav_item,
  { name: t("layouts.application.nav.reports"), path: reports_path, icon: "chart-bar" },
  plan_nav_item,
  { name: t("layouts.application.nav.assistant"), path: chats_path, icon: "sparkles", mobile_only: true }
].compact %>
<% bootstrap = {
  navItems: nav_items.map { |item|
    {
      label: item.fetch(:name),
      href: item.fetch(:path),
      icon: item.fetch(:icon),
      preview: item[:preview] || false,
      mobileOnly: item[:mobile_only] || false
    }
  },
  currentUser: {
    id: Current.user.id,
    name: Current.user.display_name,
    initials: Current.user.initials,
    email: Current.user.email
  },
  notificationInbox: preview_features_enabled? ? {
    href: web_notifications_path,
    label: t("web_notifications.inbox.title")
  } : nil,
  apiPaths: {
    home: api_v1_home_path,
    transactions: api_v1_transactions_path,
    recurringTransactions: api_v1_recurring_transactions_path,
    summary: api_v1_balance_sheet_path,
    accounts: api_v1_accounts_path,
    accountFormOptions: api_v1_account_form_options_path,
    properties: api_v1_properties_path,
    propertyFormOptions: form_options_api_v1_properties_path,
    categories: api_v1_categories_path,
    merchants: api_v1_merchants_path,
    tags: api_v1_tags_path,
    transfers: api_v1_transfers_path,
    sureqlRun: api_v1_report_run_path,
    chats: api_v1_chats_path
  },
  recurringTransactionsDisabled: Current.family.recurring_transactions_disabled?,
  uncategorizedCount: @uncategorized_count,
  reportBuilderText: I18n.t("report_builder"),
  transactionTransferMatchText: t("transactions.transfer_match"),
  accountDetailText: t("accounts.show.spa").merge(
    category_not_applicable: t("transactions.form.category_not_applicable"),
    category_label: t("transactions.form.category"),
    category_set_on_outflow: t("transactions.show.category_set_on_outflow"),
    creation_expense_tab: t("shared.transaction_tabs.expense"),
    creation_income_tab: t("shared.transaction_tabs.income"),
    creation_transfer_tab: t("shared.transaction_tabs.transfer"),
    creation_type_label: t("shared.transaction_tabs.aria", default: "Transaction type")
  ),
  homeText: {
    welcome: t("pages.dashboard.welcome"),
    subtitle: t("pages.dashboard.subtitle"),
    new: t("pages.dashboard.new"),
    investment_title: t("pages.dashboard.investment_summary.title"),
    investment_total_return: t("pages.dashboard.investment_summary.total_return"),
    investment_holding: t("pages.dashboard.investment_summary.holding"),
    investment_weight: t("pages.dashboard.investment_summary.weight"),
    investment_value: t("pages.dashboard.investment_summary.value"),
    investment_return: t("pages.dashboard.investment_summary.return"),
    investment_contributions: t("pages.dashboard.investment_summary.contributions"),
    investment_withdrawals: t("pages.dashboard.investment_summary.withdrawals"),
    investment_trades: t("pages.dashboard.investment_summary.trades"),
    insights_title: t("pages.dashboard.insights_feed.title"),
    insights_header: t("insights.feed.header"),
    insights_acknowledge: t("insights.card.acknowledge"),
    cash_forecast_title: t("pages.dashboard.cash_forecast.title"),
    cash_forecast_balance: t("pages.dashboard.cash_forecast.balance"),
    cash_forecast_instructions: t("pages.dashboard.cash_forecast.instructions"),
    cash_forecast_starting: t("pages.dashboard.cash_forecast.starting"),
    cash_forecast_ending: t("pages.dashboard.cash_forecast.ending"),
    cash_forecast_low: t("pages.dashboard.cash_forecast.low"),
    cash_forecast_first_negative: t("pages.dashboard.cash_forecast.first_negative"),
    cash_forecast_below_zero: t("pages.dashboard.cash_forecast.below_zero"),
    cash_forecast_no_activity: t("pages.dashboard.cash_forecast.no_activity"),
    money_flow_chart_label: t("pages.dashboard.money_flow.chart_label"),
    money_flow_chart_instructions: t("pages.dashboard.money_flow.chart_instructions"),
    money_flow_income: t("pages.dashboard.money_flow.income"),
    money_flow_expenses: t("pages.dashboard.money_flow.expenses"),
    spending_trend_chart_label: t("pages.dashboard.spending_trend.chart_label"),
    spending_trend_chart_instructions: t("pages.dashboard.spending_trend.chart_instructions"),
    insights_preview: t("shared.preview"),
    no_accounts_title: t("pages.dashboard.no_accounts.title"),
    no_accounts_description: t("pages.dashboard.no_accounts.description"),
    no_accounts_add: t("pages.dashboard.no_accounts.add_account"),
  },
  bulkUpdateText: t("transactions.bulk_updates.new"),
  flashMessages: flash.to_hash.slice("notice", "alert").map { |kind, message|
    { message: message.to_s, variant: kind == "alert" ? "error" : "success" }
  },
  transactionCreation: {
    currencies: currency_picker_options_for_family(extra: account_currencies.values).map { |code|
      currency = Money::Currency.new(code)
      { code: currency.iso_code, name: currency.name, step: currency.step.to_s, minorUnitConversion: currency.minor_unit_conversion }
    },
    accountCurrencies: account_currencies,
    defaultCurrency: Current.family.currency,
    defaultAccountId: default_account && account_currencies.key?(default_account.id) ? default_account.id : nil
  },
  railsPaths: {
    home: root_path,
    logo: image_path("logomark-color.svg"),
    accounts: accounts_path,
    budgets: budgets_path,
    dashboards: dashboards_path,
    imports: imports_path,
    newImport: new_import_path,
    newTransaction: new_transaction_path,
    newTransfer: new_transfer_path,
    newBulkUpdate: new_transactions_bulk_update_path,
    reports: reports_path,
    lifetimeProjection: lifetime_projection_path,
    settings: settings_profile_path,
    changelog: changelog_path,
    transactions: transactions_path,
    familyMerchants: family_merchants_path,
    newRule: new_rule_path,
    recurringTransactions: recurring_transactions_path,
    rules: rules_path,
    categories: categories_path,
    tags: tags_path,
    transactionsCategorize: transactions_categorize_path,
    chats: chats_path,
    newChat: new_chat_path
  },
  railsUrlTemplates: {
    newTransactionSplit: "#{transactions_path}/:transaction_id/split/new",
    newTransactionTransferMatch: "#{transactions_path}/:transaction_id/transfer_match/new"
  }
} %>

<div id="spa-root"></div>
<script id="spa-bootstrap" type="application/json"><%= raw json_escape(bootstrap.to_json) %></script>
