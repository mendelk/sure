namespace :cube do
  desc "Generate the Cube cash-flow model from Sure's reporting SQL"
  task generate: :environment do
    dimension = ->(name, type = "string") { { "name" => name, "sql" => "{CUBE}.#{name}", "type" => type } }
    model = {
      "cubes" => [ {
        "name" => "cash_flow",
        "sql" => CubeAnalytics.dataset_sql,
        "refresh_key" => { "every" => "10 seconds" },
        "dimensions" => [
          dimension.call("id").merge("primary_key" => true),
          dimension.call("family_id"),
          dimension.call("account_id"),
          dimension.call("date", "time").merge("sql" => "{CUBE}.date::timestamp"),
          dimension.call("category"),
          dimension.call("account"),
          dimension.call("reporting_currency")
        ],
        "measures" => [
          { "name" => "count", "type" => "count" },
          { "name" => "income", "type" => "sum", "sql" => "CASE WHEN {CUBE}.classification = 'income' THEN -{CUBE}.amount ELSE 0 END", "format" => "currency" },
          { "name" => "expenses", "type" => "sum", "sql" => "CASE WHEN {CUBE}.classification = 'expense' THEN {CUBE}.amount ELSE 0 END", "format" => "currency" },
          { "name" => "savings", "type" => "number", "sql" => "{income} - {expenses}", "format" => "currency" }
        ]
      } ]
    }
    destination = Rails.root.join("cube/model/cash_flow.yml")
    FileUtils.mkdir_p(destination.dirname)
    File.write(destination, "# Generated by bin/rails cube:generate; do not edit.\n" + model.to_yaml)
    puts "Generated #{destination.relative_path_from(Rails.root)}"
  end

  desc "Print the server-only Cube signing key for deployment"
  task secret: :environment do
    puts CubeAnalytics.api_secret
  end
end
