ARG BASE_IMAGE=sure-orca-devcontainer
FROM ${BASE_IMAGE}

RUN apt-get update -qq \
  && apt-get -y install --no-install-recommends openssh-server rsync watchman \
  && rm -rf /var/lib/apt/lists /var/cache/apt/archives \
  && mkdir -p /run/sshd /root/.ssh \
  && chmod 700 /root/.ssh \
  && ssh-keygen -A \
  && printf '%s\n' \
    'PermitRootLogin prohibit-password' \
    'PasswordAuthentication no' \
    'PubkeyAuthentication yes' \
    > /etc/ssh/sshd_config.d/orca.conf

COPY .devcontainer/orca-ssh-entrypoint /usr/local/bin/orca-ssh-entrypoint

RUN chmod 755 /usr/local/bin/orca-ssh-entrypoint

# Pre-bake gems so a fresh per-worktree bundle volume is seeded from the image
# instead of downloading and compiling every gem on first boot. A fresh named
# volume mounted at /bundle is auto-populated from the image contents.
COPY Gemfile Gemfile.lock .ruby-version /bundle-setup/
RUN cd /bundle-setup \
  && bundle config set --local path /bundle \
  && bundle install --jobs "$(nproc)" \
  && sha256sum Gemfile.lock > /etc/sure-gemfile-lock.sha256 \
  && rm -rf /bundle-setup

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/orca-ssh-entrypoint"]
