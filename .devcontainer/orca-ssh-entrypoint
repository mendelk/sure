#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${ORCA_SSH_PUBLIC_KEY:-}" ]]; then
  echo "ORCA_SSH_PUBLIC_KEY is required" >&2
  exit 1
fi

install -d -m 700 /root/.ssh
printf '%s\n' "$ORCA_SSH_PUBLIC_KEY" > /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys

start_workspace() {
  until [[ -x /workspace/bin/setup && -f /workspace/config/application.rb && -f /workspace/package-lock.json ]]; do
    sleep 1
  done

  cd /workspace
  [[ -f .env.local ]] || cp .env.local.example .env.local
  [[ -f .env.test ]] || cp .env.test.example .env.test
  bin/setup
  rm -f tmp/pids/server.pid
  exec bin/dev
}

start_workspace >/tmp/sure-workspace.log 2>&1 &
exec /usr/sbin/sshd -D -e
