{
	// Root oxfmt configuration for the pnpm workspace (apps/* plus workspace
	// manifests). Run from the repo root: `pnpm format:check:web` (check) or
	// `pnpm format:web` (write).
	//
	// Scope notes:
	// - Tabs match the existing repo style (see root/biome-adjacent files).
	// - Rails JavaScript (app/javascript) stays on Biome; Markdown stays
	//   unformatted (out of scope for this workspace config); lockfiles are
	//   never reformatted.
	// - Generated files (routeTree.gen.ts, design-token outputs) and build
	//   outputs are ignored. Token outputs stay byte-deterministic via
	//   `npm run tokens:check` instead of the formatter.
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/coverage/**",
		"**/routeTree.gen.ts",
		"apps/web/src/styles/sure-tokens.stylex.ts",
		"apps/web/src/styles/sure-token-values.ts",
		"apps/web/src/styles/sure-theme.css",
		"**/*.min.*",
		"**/*.md",
		"pnpm-lock.yaml",
		"package-lock.json"
	]
}
