# Deployment-level Sure API origin.
#
# Copy to `.env` for local development:
#
#   cp .env.example .env
#
# The value must be an absolute http(s) URL with no path, pointing at the
# Rails API (see apps/web/README.md for running both together).
SURE_API_ORIGIN=http://localhost:3000
# Optional deployment BFF-to-Rails API key, attached server-side only by the
# BFF transport (src/lib/sure-api-bff.server.ts). Never exposed to the
# browser (ADR-0001 D1/REQ-SESS-01). Leave unset for per-session bearer auth.
# SURE_API_KEY=
