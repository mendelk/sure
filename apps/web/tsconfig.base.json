{
	// Shared strict compiler options for every @sure/web TypeScript boundary.
	// Boundary projects (app / server / test) extend this file and only differ
	// in include/exclude scopes, libs, and ambient types. The plain
	// tsconfig.json (IDE default) also extends it and covers everything.
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		// Strictest safety net.
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// ESM hygiene: type-only imports must use `import type`, and only
		// erasable syntax is allowed (no enums/namespaces/parameter props).
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	}
}
