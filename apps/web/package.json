{
	"name": "@sure/web",
	"version": "0.1.0",
	"private": true,
	"description": "Sure alternate frontend (TanStack Start)",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview --port 5173",
		"pretypecheck": "tsr generate",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
		"typecheck:app": "tsc --noEmit -p tsconfig.app.json",
		"typecheck:server": "tsc --noEmit -p tsconfig.server.json",
		"typecheck:test": "tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"storybook": "STORYBOOK=1 storybook dev -p 6006",
		"build-storybook": "STORYBOOK=1 storybook build -o storybook-static",
		"test:browser": "node scripts/storybook-browser-check.mjs",
		"api:generate": "openapi-typescript ../../docs/api/openapi.yaml -o src/lib/api/openapi.d.ts",
		"api:check": "openapi-typescript ../../docs/api/openapi.yaml -o /tmp/sure-openapi-check.d.ts && diff -u /tmp/sure-openapi-check.d.ts src/lib/api/openapi.d.ts",
		"install:clean": "pnpm install --frozen-lockfile"
	},
	"dependencies": {
		"@stylexjs/stylex": "^0.19.0",
		"@tanstack/react-query": "^5.90.0",
		"@tanstack/react-router": "^1.170.0",
		"@tanstack/react-router-ssr-query": "^1.167.0",
		"@tanstack/react-start": "^1.168.0",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.0",
		"react-aria-components": "^1.21.1",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@stylexjs/unplugin": "^0.19.0",
		"@tanstack/router-cli": "1.167.34",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.0",
		"axe-core": "^4.13.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.55.0",
		"storybook": "^10.6.0",
		"typescript": "~5.9.0",
		"vite": "^8.0.0",
		"vitest": "^3.2.0",
		"vitest-axe": "^0.1.0"
	},
	"engines": {
		"node": ">=24"
	}
}
