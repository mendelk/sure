{
	"name": "@sure/web",
	"version": "0.1.0",
	"private": true,
	"description": "Sure alternate frontend (TanStack Start)",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview --port 5173",
		"pretypecheck": "tsr generate",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
		"typecheck:app": "tsc --noEmit -p tsconfig.app.json",
		"typecheck:server": "tsc --noEmit -p tsconfig.server.json",
		"typecheck:test": "tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"install:clean": "pnpm install --frozen-lockfile"
	},
	"dependencies": {
		"@stylexjs/stylex": "^0.19.0",
		"@tanstack/react-query": "^5.90.0",
		"@tanstack/react-router": "^1.170.0",
		"@tanstack/react-router-ssr-query": "^1.167.0",
		"@tanstack/react-start": "^1.168.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@stylexjs/unplugin": "^0.19.0",
		"@tanstack/router-cli": "1.167.34",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.0",
		"typescript": "~5.9.0",
		"vite": "^8.0.0",
		"vitest": "^3.2.0"
	},
	"engines": {
		"node": ">=24"
	}
}
